<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Barcli20.MainPage"
    Shell.NavBarIsVisible="False"     
    BackgroundColor="White"
    Padding="16">

    <!-- Grid base en paisaje: logo arriba izq, entrada a lo ancho, nombre izq, precio der, logo2 abajo izq -->
    <Grid
        RowDefinitions="Auto, Auto, Auto, *, Auto"
        ColumnDefinitions="*, Auto">

        <!-- LOGO SUPERIOR (SIN BORDE) -->
        <Image Grid.Row="0" Grid.Column="0"
               Source="logo.png"
               Aspect="AspectFit"
               Margin="0,0,24,0"
               HorizontalOptions="Start"
               HeightRequest="180" />

        <!-- ENTRY (SIN BORDE) OCUPA 2 COLUMNAS -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Entry x:Name="codigoEntry"
                   Placeholder="Cuadro Texto"
                   FontSize="22"
                   Completed="OnCodigoCompleted"
                   TextChanged="codigoEntry_TextChanged"
                   Focused="codigoEntry_Focused"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Fill"
                   ShowSoftInputOnFocus="False"
                   />
            <!-- línea fina decorativa opcional: quítala si no la quieres -->
            <!--<BoxView HeightRequest="1" BackgroundColor="#202020" VerticalOptions="End" />-->
        </Grid>

        <!-- NOMBRE DEL ARTÍCULO (IZQUIERDA, AZUL) -->
        <Label Grid.Row="2" Grid.Column="0"
               x:Name="descripcionLabel"
               Text=""
               TextColor="#3F51B5"
               FontSize="48"
               Margin="8,18,0,0" />

        <!-- PRECIO (DERECHA, ROJO, ALINEADO A LA DERECHA) -->
        <Label Grid.Row="3" Grid.Column="1"
               x:Name="precioLabel"
               Text="0.00"
               TextColor="#D32F2F"
               FontSize="52"
               HorizontalTextAlignment="End"
               VerticalTextAlignment="Center"
               HorizontalOptions="End"
               Margin="24,18,0,0" />

        <!-- ÁREA CENTRAL LIBRE (Row 3) -->

        <!-- LOGO INFERIOR (SIN BORDE) -->
        <Image Grid.Row="4" Grid.Column="0"
               Source="david.png"
               Aspect="AspectFit"
               Margin="0,18,0,0"
               HorizontalOptions="Start"
               HeightRequest="240" />
    </Grid>
</ContentPage>

