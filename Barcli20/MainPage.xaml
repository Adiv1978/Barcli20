<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Barcli20.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White"
    Padding="16">

    <!-- Layout adaptable para tablet/quiosco: evita alturas fijas y reparte el espacio -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- LOGO SUPERIOR -->
        <Image Grid.Row="0"
               Source="logo.png"
               Aspect="AspectFit"
               HorizontalOptions="Start"
               MaximumHeightRequest="140"
               Margin="0,0,0,8" />

        <!-- ENTRADA CÓDIGO -->
        <Grid Grid.Row="1" Margin="0,8,0,12">
            <Entry x:Name="codigoEntry"
                   Placeholder="Cuadro Texto"
                   FontSize="{OnIdiom Phone=20, Tablet=28, Desktop=28}"
                   Completed="OnCodigoCompleted"
                   TextChanged="codigoEntry_TextChanged"
                   Focused="codigoEntry_Focused"
                   BackgroundColor="Transparent"
                   HorizontalOptions="Fill"
                   ShowSoftInputOnFocus="False" />
        </Grid>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="24"
              VerticalOptions="FillAndExpand">

            <!-- DESCRIPCIÓN -->
            <Label Grid.Column="0"
                   x:Name="descripcionLabel"
                   Text=""
                   TextColor="#3F51B5"
                   FontSize="{OnIdiom Phone=36, Tablet=54, Desktop=54}"
                   LineBreakMode="WordWrap"
                   MaxLines="4"
                   VerticalOptions="Start" />

            <!-- PRECIO -->
            <Label Grid.Column="1"
                   x:Name="precioLabel"
                   Text="0.00"
                   TextColor="#D32F2F"
                   FontSize="{OnIdiom Phone=44, Tablet=68, Desktop=68}"
                   HorizontalTextAlignment="End"
                   VerticalTextAlignment="Start"
                   HorizontalOptions="End"
                   LineBreakMode="NoWrap" />
        </Grid>

        <!-- LOGO INFERIOR -->
        <Image Grid.Row="3"
               Source="david.png"
               Aspect="AspectFit"
               HorizontalOptions="Start"
               VerticalOptions="End"
               MaximumHeightRequest="180"
               Margin="0,12,0,0" />
    </Grid>
</ContentPage>
